# ============================
# TukangNDeso Production Config
# ============================
# Copy this file to .env and fill in real values

# Database
DB_USER=tukangndeso
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=tukangndeso

# JWT (min 32 chars, random string)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# CORS (your domains)
CORS_ORIGINS=https://tukangndeso.id,https://www.tukangndeso.id,https://admin.tukangndeso.id

# QRIS Payment — Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXX
MIDTRANS_IS_PRODUCTION=false
QRIS_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET_FOR_WEBHOOK_VERIFICATION

# OTP — Fonnte WhatsApp
FONNTE_API_TOKEN=YOUR_FONNTE_API_TOKEN_HERE

# CDN / Uploads
CDN_BASE_URL=https://api.tukangndeso.id

# Google Maps (for Flutter app)
GOOGLE_MAPS_API_KEY=

# FCM Push Notification
FCM_SERVICE_ACCOUNT_PATH=
