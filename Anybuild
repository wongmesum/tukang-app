# Wasmer GitHub deployments build from the repository root. Keep the API as
# the isolated application directory so web/admin packages are not detected as
# the deployment target.
load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

app_subdir = "api"

config = node_config(
    schema = 1,
    commands = {
        "start": "node dist/wasmer/server.js",
    },
    node_build_command = "bun run build:wasmer",
    node_package_manager = "bun",
    node_server = "hono",
    node_version = "24",
)

build = node_build(config)

node_serve(config, build, name = "tukangndeso-api")
