# Based on Wasmer Anybuild's official Node + Hono provider.
load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node dist/wasmer/server.js",
    },
    node_build_command = "bun run build:wasmer",
    node_package_manager = "bun",
    node_server = "hono",
    node_version = "24",
)

build = node_build(config)

node_serve(config, build, name = "tukangndeso-api")
