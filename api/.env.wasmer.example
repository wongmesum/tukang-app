# TukangNDeso API - Wasmer staging environment template
# Copy values into Wasmer app secrets/environment. Do not commit real secrets.

NODE_ENV=production
PORT=80
REPOSITORY_MODE=prisma

# Stateful services must be external
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tukangndeso?schema=public"
REDIS_URL="rediss://USER:PASSWORD@HOST:PORT"

# Auth
JWT_SECRET="replace-with-strong-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# CORS - adjust staging hostname after first Wasmer deployment
CORS_ORIGINS="https://geje.tech,https://www.geje.tech,https://wongmesum.github.io"

# Stateless jobs: no long-running interval in Wasmer
BACKGROUND_JOBS_ENABLED=false
INTERNAL_JOB_SECRET="replace-with-strong-random-secret"

# QRIS / Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
QRIS_WEBHOOK_SECRET="replace-with-strong-random-secret"

# Cloudflare R2
UPLOAD_STORAGE=r2
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="tukangndeso"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
CDN_BASE_URL="https://cdn.geje.tech"
UPLOAD_MAX_SIZE_MB=5

# Other integrations
GOOGLE_MAPS_API_KEY=""
FCM_SERVICE_ACCOUNT_PATH=""
