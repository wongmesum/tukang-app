# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tukangndeso?schema=public"
# Defaults to prisma outside test. Set memory only for local offline development.
REPOSITORY_MODE="prisma"

# Redis (for OTP store, token revocation, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Background jobs
# cPanel/local: true keeps the legacy 15-second interval.
# Stateless/Wasmer staging: false, then call POST /internal/jobs/expire-orders externally.
BACKGROUND_JOBS_ENABLED=true
INTERNAL_JOB_SECRET="replace-with-a-strong-random-secret"

# QRIS (Midtrans sandbox)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Shared secret used to verify SHA-256 HMAC webhook signatures
QRIS_WEBHOOK_SECRET="replace-with-a-strong-random-secret"

# File uploads
# local = existing cPanel/dev disk storage
# r2    = Cloudflare R2 via the S3-compatible API
UPLOAD_STORAGE="local"
UPLOAD_MAX_SIZE_MB=5

# Cloudflare R2 / S3-compatible storage
# Example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET="tukangndeso"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Cloudflare R2 uses region "auto" for S3 signing.
S3_REGION="auto"
# Public/custom domain that serves this bucket, e.g. https://cdn.geje.tech
CDN_BASE_URL=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# FCM (push notification)
FCM_SERVICE_ACCOUNT_PATH=""
