# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tukangndeso?schema=public"
# Defaults to prisma outside test. Set memory only for local offline development.
REPOSITORY_MODE="prisma"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# QRIS (Midtrans sandbox)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Shared secret used to verify SHA-256 HMAC webhook signatures
QRIS_WEBHOOK_SECRET="replace-with-a-strong-random-secret"

# Storage (S3 compatible)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-southeast-1"

# Google Maps
GOOGLE_MAPS_API_KEY=""

# FCM (push notification) — Firebase Admin SDK
# Option 1: Service account file path
FCM_SERVICE_ACCOUNT_PATH=""
# Option 2: Individual credentials (preferred for containers/serverless)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
