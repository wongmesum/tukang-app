# TukangNDeso Flutter App — Environment Variables
# Copy this to .env and fill in real values

# Environment: development | staging | production
ENV=development

# Google Maps API Key (for Android & iOS)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Backend API URL
API_BASE_URL=http://10.0.2.2:3000/v1

# Firebase (configuration via google-services.json / GoogleService-Info.plist)
# No env vars needed — just place the config files in:
# - android/app/google-services.json
# - ios/Runner/GoogleService-Info.plist
